// Product catalog schema.
//
// Provider is SQLite so the whole app runs with zero paid services. Every
// model avoids Postgres-only features (no native enums, no array columns), so
// switching `provider` to "postgresql" later is a datasource change only.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// Admin accounts. There is deliberately no customer-facing user model.
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String
  role         String   @default("admin")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Category {
  id          String     @id @default(cuid())
  name        String
  slug        String     @unique
  description String?
  imageId     String?
  image       Media?     @relation("CategoryImage", fields: [imageId], references: [id], onDelete: SetNull)
  sortOrder   Int        @default(0)
  isPublished Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  products    Product[]

  @@index([isPublished, sortOrder])
}

model Product {
  id           String         @id @default(cuid())
  designNumber String         @unique
  name         String
  slug         String         @unique
  description  String?
  /// JSON encoded string[] — searchable tags.
  tags         String         @default("[]")
  /// JSON encoded { label, value }[] — optional specifications / custom fields.
  specs        String         @default("[]")
  categoryId   String?
  category     Category?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  sortOrder    Int            @default(0)
  isPublished  Boolean        @default(true)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  images       ProductImage[]

  @@index([isPublished, sortOrder])
  @@index([categoryId, isPublished])
  @@index([createdAt])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  mediaId   String
  media     Media   @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  sortOrder Int     @default(0)
  isPrimary Boolean @default(false)

  @@unique([productId, mediaId])
  @@index([productId, sortOrder])
}

/// An uploaded image. `kind` is "product" (watermarked derivatives are public),
/// or "logo" (brand / watermark assets, served as-is without watermarking).
model Media {
  id           String  @id @default(cuid())
  filename     String
  originalName String
  mimeType     String
  kind         String  @default("product")
  width        Int
  height       Int
  bytes        Int
  /// Relative path inside the private originals directory, when retained.
  originalPath String?
  /// JSON encoded { thumb, card, detail } paths inside the public directory.
  variants     String  @default("{}")
  alt          String?
  createdAt    DateTime @default(now())

  productImages    ProductImage[]
  categoryImages   Category[]     @relation("CategoryImage")
  settingsAsLogo      Settings[]  @relation("SettingsLogo")
  settingsAsWatermark Settings[]  @relation("SettingsWatermark")

  @@index([kind, createdAt])
}

/// Single row (id = "site") holding every admin-editable site setting.
model Settings {
  id String @id @default("site")

  // Business
  businessName String  @default("My Catalog")
  tagline      String?
  logoId       String?
  logo         Media?  @relation("SettingsLogo", fields: [logoId], references: [id], onDelete: SetNull)
  address      String?
  phone        String?
  email        String?
  footerText   String?

  // WhatsApp (digits only, international format e.g. 919876543210)
  whatsappNumber         String  @default("")
  whatsappGeneralMessage String  @default("Hello, I would like to make an enquiry regarding your products.")
  whatsappProductMessage String  @default("Hello, I am interested in your product.\n\nProduct: {productName}\nDesign No.: {designNumber}\nCategory: {categoryName}\n\nPlease share the price and details.")

  // Map
  mapEmbedUrl String?
  mapLink     String?
  latitude    Float?
  longitude   Float?

  // Social links
  instagramUrl String?
  facebookUrl  String?
  youtubeUrl   String?
  twitterUrl   String?
  linkedinUrl  String?

  // Watermark configuration
  watermarkEnabled     Boolean @default(true)
  watermarkLogoId      String?
  watermarkLogo        Media?  @relation("SettingsWatermark", fields: [watermarkLogoId], references: [id], onDelete: SetNull)
  watermarkOpacity     Float   @default(0.18)
  watermarkScale       Float   @default(0.22)
  watermarkRotation    Int     @default(-30)
  watermarkRepetitions Int     @default(4)

  // Website / SEO
  siteTitle       String  @default("Product Catalog")
  siteDescription String  @default("Browse our catalog and enquire on WhatsApp.")
  defaultSort     String  @default("manual")

  updatedAt DateTime @updatedAt @default(now())
}
