# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# ---------------------------------------------------------------------------

# SQLite database file (swap for a Postgres URL later without code changes)
DATABASE_URL="file:./dev.db"

# Secret used to sign the admin session cookie.
# Generate one with:  openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-string"

# Public base URL of the site (used for SEO metadata, sitemap and OG tags)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# First admin account, created by `npm run db:seed`.
# Change the password after the first login.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="ChangeMe123!"
ADMIN_NAME="Store Admin"

# Where uploaded images live on disk. Originals are kept private; only the
# watermarked derivatives under <STORAGE_DIR>/public are ever served.
STORAGE_DIR="./storage"

# Firebase Storage bucket for watermarked images (leave empty for local disk)
FIREBASE_STORAGE_BUCKET=""
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=""
